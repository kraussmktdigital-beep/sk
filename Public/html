jjjjjj<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#090a0d"><title>JS Análises | Inteligência Financeira</title><style>
:root{--bg:#090a0d;--panel:#12151b;--line:#2b2d34;--gold:#dfb64d;--text:#f4f2ec;--muted:#a0a4ad;--green:#75d5a0;--red:#ff8989}*{box-sizing:border-box}body{margin:0;background:radial-gradient(ellipse at 75% -20%,#493718,transparent 42%),var(--bg);color:var(--text);font:15px/1.55 Inter,system-ui,sans-serif}header{position:sticky;top:0;background:#090a0df2;border-bottom:1px solid #4a3a1c;backdrop-filter:blur(14px);z-index:4}.wrap{max-width:1220px;margin:auto;padding:16px 22px}.brand{display:flex;align-items:center;gap:13px}.crest{height:55px;width:50px;clip-path:polygon(0 0,100% 0,100% 72%,50% 100%,0 72%);background:linear-gradient(135deg,#ffedb4,#b88628);color:#141108;display:grid;place-content:center;text-align:center;font:700 22px Georgia}.crest small{font:700 6px system-ui;letter-spacing:1px}.brand h1{font-size:18px;letter-spacing:1.5px;margin:0}.brand h1 span,.gold{color:var(--gold)}.brand p{font-size:9px;letter-spacing:1.6px;color:#b7aa88;margin:3px 0}.status{margin-left:auto;font-size:11px;color:var(--muted);text-align:right}nav{display:flex;gap:6px;overflow:auto;padding:0 22px 13px;max-width:1264px;margin:auto}button{font:inherit;cursor:pointer;border:1px solid #393a40;border-radius:5px;background:#181a20;color:#e9e1cf;padding:10px 13px;white-space:nowrap}button.active,.primary{background:linear-gradient(135deg,#f4d783,#bd8728);color:#151108;border-color:#e0b54c;font-weight:750}main{max-width:1220px;margin:26px auto;padding:0 22px}.hero{min-height:340px;border:1px solid #514020;border-radius:8px;overflow:hidden;display:grid;grid-template-columns:1.25fr 1fr;background:linear-gradient(90deg,#0d0f13 0%,#0d0f13ed 48%,#0d0f1355 100%),url('https://images.unsplash.com/photo-1611974789855-9c2a0a7236a3?auto=format&fit=crop&w=1400&q=85') center/cover}.heroText{padding:clamp(24px,5vw,55px)}.eyebrow{color:var(--gold);font-size:10px;letter-spacing:2px;font-weight:800}.hero h2{font-size:clamp(32px,4.4vw,53px);line-height:1.05;letter-spacing:-1.7px;margin:16px 0}.hero p{max-width:600px;color:#c4c5c9}.heroAside{display:flex;align-items:end;justify-content:end;padding:20px}.glass{background:#0b0d10d9;border:1px solid #6d5628;padding:18px;max-width:290px;border-radius:6px;backdrop-filter:blur(12px)}.glass strong{color:var(--gold)}.glass p{font-size:12px;color:#b8bac0}.section{display:none}.section.active{display:block}.head{display:flex;justify-content:space-between;align-items:end;gap:15px;flex-wrap:wrap;margin:24px 0 15px}.head h2{margin:4px 0}.muted{color:var(--muted)}.grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:13px;margin:15px 0}.card{background:linear-gradient(145deg,#16191f,#101216);border:1px solid var(--line);border-radius:7px;padding:18px;min-width:0}.metric{font-size:27px;font-weight:800;color:#f2d78b;overflow-wrap:anywhere}.label{font-size:10px;letter-spacing:1.3px;color:#b7aa8a}.controls{display:flex;gap:8px;flex-wrap:wrap}.input,select,textarea{font:inherit;color:var(--text);background:#0a0c10;border:1px solid #393c43;border-radius:4px;padding:11px;min-width:0}.controls input{width:min(340px,100%)}.tablewrap{overflow:auto;border:1px solid #303239;border-radius:5px}table{border-collapse:collapse;width:100%;min-width:650px;font-size:13px}th,td{padding:12px;text-align:left;border-bottom:1px solid #2a2c31}th{font-size:10px;letter-spacing:1px;color:#d9c07c;background:#181a20}.green{color:var(--green)}.red{color:var(--red)}.formgrid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.field{display:flex;flex-direction:column;gap:6px}.field label{font-size:12px;color:#c4c6cb}.field textarea{min-height:90px}.report{white-space:pre-wrap;line-height:1.75;font-size:14px}.notice{margin:16px 0;padding:12px 15px;background:#211b0e;border-left:3px solid var(--gold);font-size:12px;color:#d7caa8}.error{color:#ffaaaa}.bar{height:7px;background:#2d2f35;border-radius:5px;overflow:hidden;margin-top:7px}.bar i{display:block;height:100%;background:linear-gradient(90deg,#ad791f,#f1d47b)}footer{border-top:1px solid #292a2f;text-align:center;padding:22px;color:#888c94;font-size:11px}@media(max-width:760px){.wrap{padding:12px}.status{display:none}.hero{grid-template-columns:1fr;background-position:center}.heroAside{justify-content:start;padding:0 24px 22px}.grid{grid-template-columns:1fr}.formgrid{grid-template-columns:1fr}main{padding:0 12px}nav{padding:0 12px 10px}.brand h1{font-size:15px}}
</style></head><body><header><div class="wrap brand"><div class="crest">JS<small>ANÁLISES</small></div><div><h1>JS <span>ANÁLISES</span></h1><p>COM BASE E CONTEÚDO · INTELIGÊNCIA FINANCEIRA</p></div><div class="status" id="status">Verificando conexão…</div></div><nav><button class="active" data-tab="inicio">Visão geral</button><button data-tab="mercado">Mercado B3</button><button data-tab="ia">Analista IA</button><button data-tab="carteira">Carteira</button><button data-tab="relatorios">Relatórios</button></nav></header>
<main><section id="inicio" class="section active"><div class="hero"><div class="heroText"><div class="eyebrow">INTELIGÊNCIA PARA O INVESTIDOR</div><h2>Invista com mais<br><span class="gold">contexto e clareza.</span></h2><p>Consulte dados de mercado, acompanhe ativos da B3 e produza relatórios assistidos por IA, com limitações e riscos explicitados.</p><button class="primary" onclick="showTab('mercado')">Explorar mercado ↗</button> <button onclick="showTab('ia')">Analisar ativo</button></div><div class="heroAside"><div class="glass"><strong>Dados antes de opinião.</strong><p>Cotações obtidas do provedor externo; análise assistida por IA; riscos e dados ausentes apresentados com transparência.</p></div></div></div><div class="grid"><div class="card"><div class="label">POSIÇÕES NA CARTEIRA</div><div class="metric" id="homeCount">0</div><p class="muted">Registros neste navegador</p></div><div class="card"><div class="label">VALOR REGISTRADO</div><div class="metric" id="homeTotal">R$ 0,00</div><p class="muted">Informado por você</p></div><div class="card"><div class="label">FONTE DE DADOS</div><div class="metric" id="provider">Brapi</div><p class="muted">A disponibilidade depende do provedor</p></div></div><div class="notice">Não é recomendação personalizada de investimento. Dados podem estar atrasados ou incompletos. Verifique fontes oficiais antes de tomar decisões.</div></section>
<section id="mercado" class="section"><div class="head"><div><div class="eyebrow">COTAÇÕES E INDICADORES</div><h2>Mercado brasileiro · B3</h2><p class="muted">Exemplos: PETR4, VALE3, ITUB4, BOVA11, HGLG11.</p></div><div class="controls"><input class="input" id="tickers" value="PETR4,VALE3,ITUB4,BOVA11,HGLG11"><button class="primary" id="load">Atualizar dados</button></div></div><p id="quoteMsg" class="muted">Solicite os dados atuais ao provedor.</p><div class="tablewrap"><table><thead><tr><th>TICKER</th><th>EMPRESA / ATIVO</th><th>PREÇO</th><th>VARIAÇÃO</th><th>VALOR DE MERCADO</th><th>FONTE / CONSULTA</th></tr></thead><tbody id="quotes"><tr><td colspan="6">Aguardando consulta.</td></tr></tbody></table></div><div class="notice">Para ampliar a cobertura de ativos, configure um token Brapi no Render. O horário e a frequência dos dados dependem do plano contratado.</div></section>
<section id="ia" class="section"><div class="head"><div><div class="eyebrow">RELATÓRIO ASSISTIDO POR IA</div><h2>Analista JS</h2><p class="muted">A IA analisa os dados recebidos; não deve inventar indicadores ausentes.</p></div></div><div class="card"><div class="formgrid"><div class="field"><label>Ticker</label><input class="input" id="ticker" value="PETR4"></div><div class="field"><label>Tipo de análise</label><select class="input" id="focus"><option>Analise fundamentos, indicadores disponíveis, riscos e dados faltantes.</option><option>Explique valuation e indicadores disponíveis sem inventar dados ausentes.</option><option>Analise riscos setoriais e cenários positivos e negativos.</option><option>Faça uma visão geral educativa e liste dados adicionais necessários.</option></select></div><div class="field" style="grid-column:1/-1"><label>Pergunta adicional</label><textarea class="input" id="question" placeholder="Ex.: explique os riscos que devo acompanhar."></textarea></div></div><p><button class="primary" id="analyze">Gerar relatório</button> <button id="fetchAnalyze">Buscar cotação e analisar</button></p><p id="aiMsg" class="muted">Configure OPENAI_API_KEY no servidor para ativar a IA.</p><div id="report" class="report"></div></div></section>
<section id="carteira" class="section"><div class="head"><div><div class="eyebrow">ACOMPANHAMENTO PATRIMONIAL</div><h2>Minha carteira</h2><p class="muted">Salva neste navegador, sem sincronização em nuvem.</p></div></div><div class="grid"><div class="card"><div class="label">VALOR TOTAL</div><div class="metric" id="total">R$ 0,00</div></div><div class="card"><div class="label">POSIÇÕES</div><div class="metric" id="count">0</div></div><div class="card"><div class="label">CLASSES</div><div class="metric" id="classes">0</div></div></div><div class="card"><h3>Adicionar posição</h3><div class="formgrid"><div class="field"><label>Ativo / ticker</label><input class="input" id="pticker" placeholder="PETR4"></div><div class="field"><label>Classe</label><select class="input" id="pclass"><option>Ação</option><option>FII</option><option>ETF</option><option>Renda fixa</option><option>Caixa</option><option>Exterior</option><option>Outro</option></select></div><div class="field"><label>Valor atual (R$)</label><input class="input" id="pvalue" type="number" min="0" step=".01"></div><div class="field"><label>Observação</label><input class="input" id="pnote"></div></div><p><button class="primary" id="add">Adicionar</button> <button id="csv">Exportar CSV</button> <button id="clear">Limpar carteira</button></p></div><div class="tablewrap" style="margin-top:15px"><table><thead><tr><th>TICKER</th><th>CLASSE</th><th>VALOR</th><th>OBSERVAÇÃO</th><th></th></tr></thead><tbody id="positions"></tbody></table></div><div class="card" style="margin-top:15px"><h3>Alocação por classe</h3><div id="allocation"></div></div></section>
<section id="relatorios" class="section"><div class="head"><div><div class="eyebrow">CENTRO DE RELATÓRIOS</div><h2>Histórico desta sessão</h2></div><button id="allReports">Exportar histórico</button></div><div class="card" id="reports" class="muted">Nenhum relatório gerado ainda.</div></section></main><footer>JS — Análises com Base e Conteúdo · Ferramenta educacional · Não é recomendação de investimento.</footer>
<script>
const $=id=>document.getElementById(id);let lastQuotes=[],reports=[];
const esc=x=>String(x??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const money=x=>x==null?'—':Number(x).toLocaleString('pt-BR',{style:'currency',currency:'BRL'});
function showTab(id){document.querySelectorAll('.section').forEach(s=>s.classList.toggle('active',s.id===id));document.querySelectorAll('nav button').forEach(b=>b.classList.toggle('active',b.dataset.tab===id));window.scrollTo({top:0,behavior:'smooth'})}
document.querySelectorAll('nav button').forEach(b=>b.onclick=()=>showTab(b.dataset.tab));
async function health(){try{const r=await fetch('/api/health'),d=await r.json();$('status').textContent=`● Dados ${d.quoteTokenConfigured?'configurados':'modo básico'} · IA ${d.aiConfigured?'ativa':'aguardando chave'}`;$('provider').textContent='Brapi'}catch{$('status').textContent='Servidor indisponível'}}
async function quote(){const symbols=$('tickers').value.trim().toUpperCase();$('quoteMsg').textContent='Buscando cotações…';try{const r=await fetch('/api/quote/'+encodeURIComponent(symbols)),d=await r.json();if(!r.ok)throw Error((d.error||'Erro')+(d.detail?' — '+d.detail:''));lastQuotes=d.results||[];$('quoteMsg').textContent=`Fonte: ${d.source} · Consulta: ${new Date(d.updatedAt).toLocaleString('pt-BR')}${d.cached?' · cache':''}`;$('quotes').innerHTML=lastQuotes.map(x=>`<tr><td><b>${esc(x.symbol)}</b></td><td>${esc(x.name)}</td><td>${money(x.price)}</td><td class="${Number(x.change)>=0?'green':'red'}">${x.change==null?'—':Number(x.change).toLocaleString('pt-BR',{maximumFractionDigits:2})+'%'}</td><td>${x.marketCap?money(x.marketCap):'—'}</td><td><small>${esc(x.source)}<br>${esc(x.time||'horário não informado')}</small></td></tr>`).join('')||'<tr><td colspan="6">Nenhum resultado.</td></tr>';$('ticker').value=lastQuotes[0]?.symbol||$('ticker').value}catch(e){$('quoteMsg').innerHTML='<span class="error">'+esc(e.message)+'</span>'}}
async function analyze(){const ticker=$('ticker').value.trim().toUpperCase();$('aiMsg').textContent='Gerando relatório…';$('report').textContent='';let q=lastQuotes.find(x=>x.symbol===ticker);try{if(!q){const rr=await fetch('/api/quote/'+encodeURIComponent(ticker)),dd=await rr.json();q=dd.results?.[0]||null}let fundamentals=null;try{const fr=await fetch('/api/fundamentals/'+encodeURIComponent(ticker));if(fr.ok)fundamentals=await fr.json()}catch{}const r=await fetch('/api/analyze',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({ticker,data:{quote:q,fundamentals},question:$('focus').value+' '+$('question').value})}),d=await r.json();if(!r.ok)throw Error((d.error||'Erro')+(d.detail?' — '+d.detail:''));$('report').textContent=d.report;$('aiMsg').textContent='Gerado em '+new Date(d.createdAt).toLocaleString('pt-BR')+' · '+d.model;reports.unshift({ticker,date:d.createdAt,report:d.report});renderReports()}catch(e){$('aiMsg').innerHTML='<span class="error">'+esc(e.message)+'</span>'}}
$('load').onclick=quote;$('analyze').onclick=analyze;$('fetchAnalyze').onclick=async()=>{await quote();showTab('ia');await analyze()};
const getP=()=>{try{return JSON.parse(localStorage.getItem('js_portfolio')||'[]')}catch{return []}},saveP=p=>{localStorage.setItem('js_portfolio',JSON.stringify(p));renderP()};
function renderP(){const p=getP(),sum=p.reduce((a,x)=>a+Number(x.value),0),cl=[...new Set(p.map(x=>x.classe))];$('total').textContent=$('homeTotal').textContent=money(sum);$('count').textContent=$('homeCount').textContent=p.length;$('classes').textContent=cl.length;$('positions').innerHTML=p.map((x,i)=>`<tr><td>${esc(x.ticker)}</td><td>${esc(x.classe)}</td><td>${money(x.value)}</td><td>${esc(x.note)}</td><td><button onclick="removeP(${i})">Remover</button></td></tr>`).join('')||'<tr><td colspan="5">Carteira vazia.</td></tr>';const group={};p.forEach(x=>group[x.classe]=(group[x.classe]||0)+Number(x.value));$('allocation').innerHTML=Object.entries(group).map(([k,v])=>`<div style="margin:10px 0"><div style="display:flex;justify-content:space-between">${esc(k)} <b>${sum?(v/sum*100).toLocaleString('pt-BR',{maximumFractionDigits:1}):0}%</b></div><div class="bar"><i style="width:${sum?v/sum*100:0}%"></i></div></div>`).join('')||'Adicione posições para visualizar a alocação.'}
window.removeP=i=>{const p=getP();p.splice(i,1);saveP(p)};
$('add').onclick=()=>{const ticker=$('pticker').value.trim().toUpperCase(),value=Number($('pvalue').value);if(!ticker||!Number.isFinite(value)||value<0){alert('Informe ticker e valor válido.');return}const p=getP();p.push({ticker,classe:$('pclass').value,value,note:$('pnote').value});saveP(p);$('pticker').value=$('pvalue').value=$('pnote').value=''};
function download(name,content,type='text/plain'){const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([content],{type}));a.download=name;a.click();setTimeout(()=>URL.revokeObjectURL(a.href),1000)}
$('csv').onclick=()=>download('JS-carteira.csv','\ufeff'+[['ticker','classe','valor','observacao'],...getP().map(x=>[x.ticker,x.classe,x.value,x.note])].map(r=>r.map(v=>'"'+String(v??'').replaceAll('"','""')+'"').join(';')).join('\n'),'text/csv;charset=utf-8');
$('clear').onclick=()=>{if(confirm('Apagar a carteira deste navegador?'))saveP([])};
function renderReports(){$('reports').innerHTML=reports.map((r,i)=>`<div style="padding:12px 0;border-bottom:1px solid #333"><b>${esc(r.ticker)} · ${new Date(r.date).toLocaleString('pt-BR')}</b><p>${esc(r.report.slice(0,300))}…</p><button onclick="exportReport(${i})">Exportar</button></div>`).join('')||'Nenhum relatório gerado ainda.'}
window.exportReport=i=>{let r=reports[i];download(`JS-relatorio-${r.ticker}.txt`,`${r.ticker}\n${r.date}\n\n${r.report}`)};
$('allReports').onclick=()=>download('JS-relatorios.txt',reports.map(r=>`${r.ticker}\n${r.date}\n${r.report}`).join('\n\n---\n\n'));
health();renderP();setInterval(health,60000);setInterval(()=>{if(document.visibilityState==='visible'&&$('mercado').classList.contains('active'))quote()},300000);
</script></body></html>
